{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug in MentorPi container",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/home/ubuntu/shared/MentorPiTemplate"
                }
            ],
            "preLaunchTask": "debug-in-mentorpi-container",
            "postDebugTask": "stop-mentorpi-debug"
        }
    ]
}