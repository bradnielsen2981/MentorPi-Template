{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-in-mentorpi-container",
            "type": "shell",
            "command": "docker exec -it -u ubuntu -w /home/ubuntu/shared/MentorPiTemplate MentorPi zsh -ic 'python3 ${relativeFile}'",
            "problemMatcher": [
                "$python"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "run-on-laptop-display",
            "type": "shell",
            "command": "[ -n \"$DISPLAY\" ] || { echo 'No forwarded display: connect with X11 forwarding and start Xming'; exit 1; }; xauth nlist $DISPLAY | sed 's/^..../ffff/' | xauth -q -f /home/pi/docker/tmp/.Xauthority-forward nmerge - && docker exec -it -u ubuntu -e DISPLAY=$DISPLAY -e XAUTHORITY=/home/ubuntu/shared/.Xauthority-forward -w /home/ubuntu/shared/MentorPiTemplate MentorPi zsh -ic 'python3 ${relativeFile}'",
            "problemMatcher": [
                "$python"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "debug-in-mentorpi-container",
            "type": "shell",
            "command": "docker exec -it -u ubuntu -w /home/ubuntu/shared/MentorPiTemplate MentorPi zsh -ic 'python3 .vscode/debug_in_container.py ${relativeFile}'",
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "pattern": {
                    "regexp": "^(__never_matches__)(\\d+)(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^__never_matches__$",
                    "endsPattern": "DEBUGPY_READY"
                }
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "stop-mentorpi-debug",
            "type": "shell",
            "command": "docker exec MentorPi pkill -f debug_in_container.py || true",
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}
